# Matches docker-compose.yml's postgres service —
# `docker compose up -d`, then `psql "$DATABASE_URL" -f sql/schema.sql`.
DATABASE_URL=postgres://jenga:jenga@localhost:5432/jenga

# GPTZero — non-blocking authenticity flag on progress reports
GPTZERO_API_KEY=

# Gemini — video analysis of report evidence (lib/video/analyze.ts). Degrades
# to an 'unavailable' analysis status (never blocks report submission) if unset.
# Uploaded clips themselves are stored on local disk under .data/media/ —
# see lib/media-store.ts's ponytail note (not for production/serverless use).
GEMINI_API_KEY=
